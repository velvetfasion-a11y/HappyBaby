# Copy this file to .env and fill in your values.

CJ_API_EMAIL=your-cj-email@example.com
CJ_API_PASSWORD=your-cj-api-password
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1
CJ_API_KEY=CJUserNum@api@xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# If you already have a real access token, you can set it directly instead:
# CJ_ACCESS_TOKEN=your-cj-access-token
CJ_PRODUCT_SKU=CJYD233025008HS

# Stripe configuration
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_CURRENCY=sek

# Product pricing in SEK
STRIPE_PRICE_STANDARD_SEK=211.89
STRIPE_PRICE_NURSERY_SEK=264.89

# Stripe Price IDs (variant order top-to-bottom)
STRIPE_PRICE_ID_YELLOW_GIRAFF=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_BLUE_BEAR=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_PINK_RABBIT=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_BEIGE_TIGER=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_YELLOW_GIRAFFE_NURSERY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_BLUE_BEAR_NURSERY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_PINK_RABBIT_NURSERY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_BEIGE_TIGER_NURSERY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_BEIGE_ORIGINAL_BEAR=price_xxxxxxxxxxxxxxxxxxxxxxxx
